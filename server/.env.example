NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/funeral_management
# Optional Spring-style variables for Render or other deployment platforms.
# If DATABASE_URL is not set, the backend will fallback to SPRING_DATASOURCE_URL.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
APP_DEEP_LINK_URL=funeralms://payment-complete
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=
APPLE_AUDIENCE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM=
